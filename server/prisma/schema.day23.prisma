generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String
  email        String   @unique
  password     String
  role         String

  bio          String?
  profileImage String?

  // ==========================
  // HUNTER SYSTEM
  // ==========================

  hunterScore  Int      @default(0)
  hunterRank   String   @default("E-RANK")
  hunterExp    Int      @default(0)
  hunterLevel  Int      @default(1)
  skillsCount  Int      @default(0)

  // Stores the complete latest AI analysis
  resumeAnalysis Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}